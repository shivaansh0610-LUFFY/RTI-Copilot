# Copy to .env and fill in. Never commit .env — this repo is public.

# Backend
# Choose your own database password; docker compose refuses to start without it.
# It is used as-is by Postgres and inside the connection URL, so stick to URL-safe
# characters (letters, digits, - . _ ~), e.g. the output of `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# Only needed when running the API outside Docker: replace the placeholder with the
# same password. docker compose builds its own URL for the api container from
# POSTGRES_PASSWORD and ignores this line.
DATABASE_URL=postgresql+psycopg://rti:<POSTGRES_PASSWORD>@localhost:5432/rti_copilot
LLM_API_KEY=
LLM_MODEL=

# Frontend (Vite only exposes variables prefixed with VITE_).
# Leave unset to run the UI on its built-in mock data without the backend.
VITE_API_URL=http://localhost:8000
