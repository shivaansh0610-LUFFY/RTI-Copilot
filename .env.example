# Copy to .env and fill in. Never commit .env — this repo is public.

# Backend
# Choose your own database password. docker compose refuses to start without it.
POSTGRES_PASSWORD=
# Use the same password here (URL-encode special characters).
DATABASE_URL=postgresql+psycopg://rti:<POSTGRES_PASSWORD>@localhost:5432/rti_copilot
LLM_API_KEY=
LLM_MODEL=

# Frontend (Vite only exposes variables prefixed with VITE_).
# Leave unset to run the UI on its built-in mock data without the backend.
VITE_API_URL=http://localhost:8000
